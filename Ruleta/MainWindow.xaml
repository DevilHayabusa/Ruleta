<Window x:Class="PrizeRoulette.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prize Roulette" Height="800" Width="1024"
        Background="#0f172a"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Static Pointer (Top center) -->
        <Polygon Points="0,0 30,0 15,40" Fill="#ef4444" 
                 HorizontalAlignment="Center" VerticalAlignment="Top" 
                 Margin="0,50,0,0" Panel.ZIndex="10"/>

        <!-- Roulette Container -->
        <!-- IsManipulationEnabled handles Touch. Mouse events handle the laptop fallback. -->
        <Grid x:Name="RouletteContainer" Width="600" Height="600"
              IsManipulationEnabled="True"
              ManipulationStarting="OnManipulationStarting"
              ManipulationCompleted="OnManipulationCompleted"
              MouseLeftButtonDown="OnMouseLeftButtonDown"
              MouseLeftButtonUp="OnMouseLeftButtonUp"
              Background="Transparent">

            <Grid.RenderTransform>
                <!-- Hardware-accelerated transform -->
                <RotateTransform x:Name="RouletteTransform" Angle="0" CenterX="300" CenterY="300"/>
            </Grid.RenderTransform>

            <!-- Dynamic Rendering Surface where C# will draw the pie slices -->
            <Canvas x:Name="RouletteCanvas" Width="600" Height="600" />
        </Grid>
    </Grid>
</Window>